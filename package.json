{
  "name": "parkflow",
  "version": "2.0.0",
  "description": "ParkFlow full-stack parking management with authenticated PostgreSQL persistence",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-concurrency=1 tests/integration/*.test.js",
    "test:prototype": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/fullstack.e2e.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "selenium-webdriver": "^4.51.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "24.x"
  }
}
